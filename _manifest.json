{
  "manifest_version": 2,
  "id": "com.yuwei.maibot-token-saver",
  "version": "1.0.1",
  "name": "Token Saver · 上下文瘦身",
  "description": "在不改动人设与近期对话的前提下压缩 Planner/Replyer 上下文、工具定义与辅助链路输入，降低 token 消耗，附带 /tokensave 统计命令。零侵入，停用即回滚。",
  "author": {
    "name": "yuwei",
    "url": "https://github.com/Mai-with-u/MaiBot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.21.99"
  },
  "capabilities": [
    "send.text"
  ],
  "plugin_type": "management",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "gauge",
      "fallback": "package"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
